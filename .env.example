# ==========================================================================
# MEDIA KIT — VARIÁVEIS DE AMBIENTE
# --------------------------------------------------------------------------
# Copie para `.env` e preencha:   cp .env.example .env
#
# ⚠️  Estas variáveis são lidas SOMENTE no servidor (serverless function /
#     middleware de dev). Nada aqui chega ao navegador. O `.env` está no
#     .gitignore — nunca faça commit dele.
# ==========================================================================

# --------------------------------------------------------------------------
# MODO DEMONSTRAÇÃO
# --------------------------------------------------------------------------
# true  → usa dados FICTÍCIOS (src/services/demo-data.js) e mostra um aviso
#         permanente no topo da página. Serve para desenvolver o layout.
# false → produção. Só dados reais. Sem integração configurada, a página
#         mostra "métricas indisponíveis" — nunca um número inventado.
DEMO_MODE=true

# --------------------------------------------------------------------------
# WINDSOR.AI  (obrigatório quando DEMO_MODE=false)
# --------------------------------------------------------------------------
# Pegue a chave em https://onboard.windsor.ai (menu API / Connectors).
WINDSOR_API_KEY=

# ID da conta do Instagram no Windsor.ai. Opcional: sem valor, a consulta
# usa todas as contas conectadas. Preencha se houver mais de uma.
WINDSOR_ACCOUNT_ID=

# Raramente precisam mudar.
WINDSOR_BASE_URL=https://connectors.windsor.ai
WINDSOR_CONNECTOR=instagram
WINDSOR_TIMEOUT_MS=20000

# --------------------------------------------------------------------------
# CACHE
# --------------------------------------------------------------------------
# Tempo de vida do cache em segundos. Padrão 21600 (6 h). As métricas do
# Instagram fecham uma vez por dia; 6 h garante que o fechamento apareça
# poucas horas depois de existir, sem consultar a Windsor a cada visita.
CACHE_TTL_SECONDS=21600

# Cache em disco (/tmp). Deixe true; use false em runtimes somente-leitura.
CACHE_DISK=true

# --------------------------------------------------------------------------
# SEGURANÇA
# --------------------------------------------------------------------------
# Máximo de requisições por IP por minuto em /api/metrics.
RATE_LIMIT_PER_MINUTE=60

# Token para forçar atualização via /api/metrics?refresh=1&token=SEU_TOKEN
# Sem valor, `?refresh=1` fica liberado (conveniente em desenvolvimento,
# mas defina um token em produção).
REVALIDATE_TOKEN=

# --------------------------------------------------------------------------
# ARQUIVO ÚNICO
# --------------------------------------------------------------------------
# `npm run build:html` gera o media-kit.html com os dados embutidos.
# Opcional: reconstruir a partir de linhas cruas já capturadas, sem tocar na
# rede — útil para regerar o arquivo offline e reproduzir a mesma saída.
# SNAPSHOT_FROM=data/windsor-snapshot.json

# --------------------------------------------------------------------------
# LOCALIZAÇÃO
# --------------------------------------------------------------------------
# Fuso usado para decidir qual é o "último dia fechado" e para exibir a
# data da última sincronização.
TIMEZONE=America/Sao_Paulo
